{
  "name": "hybrid-command-center",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "test": "node --test src/dashboard/*.test.js tests/native/cdp.test.js tests/native/host.test.js tests/release.test.js",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:browser": "npm run test:e2e",
    "build:native:test": "tauri build --debug --no-bundle -- --offline",
    "test:native": "node --test tests/native/desktop.test.js",
    "test:native:coexist": "node tests/native/coexist.js",
    "test:native:smoke": "node --test --test-name-pattern=\"main window\" tests/native/desktop.test.js",
    "test:rust": "cargo test --offline --manifest-path src-tauri/Cargo.toml",
    "test:all": "npm test && npm run test:browser && npm run test:rust && npm run build:native:test && npm run test:native"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}
